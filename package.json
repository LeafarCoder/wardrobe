{
  "name": "wardrobe",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first AI wardrobe gallery powered by OpenRouter or OpenAI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "check": "npm test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-cli.mjs migrate",
    "db:verify": "node --env-file-if-exists=.env scripts/db-cli.mjs verify",
    "db:predeploy": "node scripts/db-cli.mjs predeploy",
    "storage:inventory": "node --env-file-if-exists=.env scripts/storage-cli.mjs inventory",
    "storage:verify": "node --env-file-if-exists=.env scripts/storage-cli.mjs verify",
    "storage:url": "node --env-file-if-exists=.env scripts/storage-cli.mjs url",
    "storage:gc": "node --env-file-if-exists=.env scripts/storage-cli.mjs gc",
    "migrate:railway": "node --env-file-if-exists=.env scripts/railway-migration.mjs migrate",
    "migrate:verify": "node --env-file-if-exists=.env scripts/railway-migration.mjs verify",
    "migrate:export-files": "node --env-file-if-exists=.env scripts/railway-migration.mjs export-files",
    "test:integration": "node --test test/persistence-integration.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@unpic/react": "^1.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "ffmpeg-static": "^5.2.0",
    "ipx": "^3.1.1",
    "pg": "^8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "vite": "6.4.3"
  }
}
