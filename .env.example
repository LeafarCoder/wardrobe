# Required before exposing Wardrobe to the internet. Use a unique, randomly
# generated password (20+ characters). This value stays on the server.
WARDROBE_ACCESS_PASSWORD=

# Local default. On Railway, attach a volume at /data and set this to /data.
WARDROBE_DATA_DIR=data
# Only enable behind a proxy that overwrites X-Real-IP / X-Forwarded-For. Login
# rate limiting keys on the client address, and a spoofable header would let a
# caller reset its own lockout. Railway sets this automatically.
WARDROBE_TRUST_PROXY=false
# Set temporarily to true to analyze stored originals that predate smart framing.
WARDROBE_BACKFILL_ORIGINAL_FOCUS=false

# Recommended low-cost OpenRouter setup.
WARDROBE_AI_PROVIDER=openrouter
WARDROBE_AI_CONCURRENCY=2
# Reference photos sent to an AI provider are resized and recompressed first.
# These defaults preserve enough detail for identity and garment matching while
# avoiding the bandwidth cost of repeatedly sending camera-resolution photos.
WARDROBE_AI_REFERENCE_MAX_EDGE=1536
WARDROBE_AI_REFERENCE_JPEG_QUALITY=84
# Photo analysis only names garments and places boxes on a 1000x1000 grid, so it
# runs below the generation reference size. Provider input cost scales with
# resolution; raise this if crowded photos start losing small accessories.
WARDROBE_AI_ANALYSIS_MAX_EDGE=1024
OPENROUTER_API_KEY=
# OpenRouter uses these attribution headers in its Apps analytics. On Railway,
# OPENROUTER_APP_URL defaults automatically to https://$RAILWAY_PUBLIC_DOMAIN.
# Set it explicitly when using a custom domain or a different canonical URL.
# OPENROUTER_APP_URL=https://wardrobe.example.com
OPENROUTER_APP_TITLE=Wardrobe
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PLANNER_MODEL=google/gemini-3.1-flash-lite
# Retried only when the primary planner provider fails or returns invalid JSON.
# Gemini 2.5 Flash Lite is inexpensive and currently has healthy ZDR routes.
OPENROUTER_PLANNER_FALLBACK_MODELS=google/gemini-2.5-flash-lite
OPENROUTER_GARMENT_MODEL=black-forest-labs/flux.2-klein-4b
# One identity reference uses the faster economy model. Profiles with two or
# three references automatically use the regular Flash model for better matching.
OPENROUTER_MODELED_MODEL=google/gemini-3.1-flash-lite-image
OPENROUTER_MODELED_MULTI_REFERENCE_MODEL=google/gemini-3.1-flash-image
# Klein currently has no ZDR route on OpenRouter. This explicit exception applies
# only to garment reconstruction; analysis and modeled looks still require ZDR.
OPENROUTER_ALLOW_NON_ZDR_GARMENT=true
OPENROUTER_GARMENT_PROVIDER=black-forest-labs
# Retried in order only when an image model returns a safety-policy refusal.
# Set this to none to disable automatic safety fallback.
OPENROUTER_IMAGE_FALLBACK_MODELS=bytedance-seed/seedream-4.5
# Seed is currently a ZDR endpoint for the default fallback model.
OPENROUTER_IMAGE_FALLBACK_PROVIDER=seed
# Keep the cheap primary image call at 1K. Seedream fallbacks need 2K on the
# current Seed route; Wardrobe steps up automatically if a route asks for more.
OPENROUTER_IMAGE_RESOLUTION=1K
OPENROUTER_IMAGE_FALLBACK_RESOLUTION=2K
OPENROUTER_IMAGE_QUALITY=auto
OPENROUTER_ZDR=true

# Optional: pin image requests to a specific OpenRouter provider tag.
# With the Google models above and ZDR enabled, Wardrobe automatically uses
# google-vertex/global so photos are not routed through Google AI Studio.
# OPENROUTER_IMAGE_PROVIDER=google-vertex/global
# OPENROUTER_MODELED_PROVIDER=google-vertex/global

# Direct OpenAI remains supported. Uncomment this block and change the provider.
# WARDROBE_AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-5.4-mini
# OPENAI_PLANNER_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high

# Optional first-run profile name and legacy reference bootstrap.
# After startup, add/edit users and their 1-3 reference photos in the app.
# WARDROBE_DEFAULT_USER_NAME=My wardrobe
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# A comma-separated list takes precedence over the single legacy reference.
# WARDROBE_MODEL_REFERENCES=data/model-front.jpg,data/model-three-quarter.jpg,data/model-full-body.jpg
