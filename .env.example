# Sign-in is per person through Google. Create an OAuth client in Google Cloud
# Console (APIs & Services > Credentials > OAuth client ID > Web application) and
# add every origin you use as an authorized redirect URI:
#   https://<your-domain>/api/auth/google/callback
#   http://localhost:5173/api/auth/google/callback     (for npm run dev)
# Wardrobe is closed until both of these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exactly who may open this instance. Anyone not listed is refused at the Google
# callback, before a profile is created. An entry may pin an existing profile id
# so a returning person claims the wardrobe they already own instead of starting
# empty; find the id in data/users.json.
#   WARDROBE_ALLOWED_EMAILS=me@gmail.com=default, partner@gmail.com
WARDROBE_ALLOWED_EMAILS=

# Optional and empty by default: with nobody listed here every account is
# strictly isolated, including yours. A listed account gains the profile
# switcher and can open any wardrobe, which is intended for the person who
# maintains the instance. Enforced on the server, not just hidden in the UI.
# WARDROBE_OWNER_EMAILS=me@gmail.com

# Signs session cookies. Any long random string. Keep it separate from the OAuth
# secret so rotating one does not sign everyone out; defaults to
# GOOGLE_CLIENT_SECRET when unset.
WARDROBE_SESSION_SECRET=

# Only needed when the public URL cannot be derived from the request, for example
# behind a custom domain that does not set RAILWAY_PUBLIC_DOMAIN.
# WARDROBE_PUBLIC_URL=https://wardrobe.example.com

# Local defaults. During the Railway migration window, this remains /data as
# the read-only legacy source. PostgreSQL and S3 are enabled together only after
# `npm run migrate:verify` succeeds.
WARDROBE_DATA_DIR=data
WARDROBE_PERSISTENCE_DRIVER=filesystem
WARDROBE_OBJECT_STORAGE_DRIVER=filesystem

# Production PostgreSQL. Railway supplies DATABASE_URL through a private
# variable reference from the Postgres service. PostgreSQL 18.x is required.
# DATABASE_URL=postgresql://...
# WARDROBE_DATABASE_POOL_SIZE=10
# WARDROBE_DATABASE_SSL=disable

# Generate once with `openssl rand -base64 32`. Required by the postgres driver
# to encrypt personal OpenRouter keys. Keep a recovery copy outside Railway.
# WARDROBE_DATA_ENCRYPTION_KEY=

# Railway private media bucket. Use variable references from the bucket service;
# names may be mapped to this explicit server-only contract.
# WARDROBE_MEDIA_S3_ENDPOINT=
# WARDROBE_MEDIA_S3_PUBLIC_ENDPOINT=
# WARDROBE_MEDIA_S3_BUCKET=wardrobe-media
# WARDROBE_MEDIA_S3_ACCESS_KEY_ID=
# WARDROBE_MEDIA_S3_SECRET_ACCESS_KEY=
# WARDROBE_MEDIA_S3_REGION=auto
# WARDROBE_MEDIA_S3_FORCE_PATH_STYLE=true

# Read-only maintenance mode permits sign-in, reads, health checks, and personal
# exports while returning a friendly 503 for mutations.
WARDROBE_MAINTENANCE_MODE=false
# Only enable behind a proxy that overwrites X-Real-IP / X-Forwarded-For. Login
# rate limiting keys on the client address, and a spoofable header would let a
# caller reset its own lockout. Railway sets this automatically.
WARDROBE_TRUST_PROXY=false
# Set temporarily to true to analyze stored originals that predate smart framing.
WARDROBE_BACKFILL_ORIGINAL_FOCUS=false

# Recommended low-cost OpenRouter setup.
WARDROBE_AI_PROVIDER=openrouter
WARDROBE_AI_CONCURRENCY=2
# Reference photos sent to an AI provider are resized and recompressed first.
# These defaults preserve enough detail for identity and garment matching while
# avoiding the bandwidth cost of repeatedly sending camera-resolution photos.
WARDROBE_AI_REFERENCE_MAX_EDGE=1536
WARDROBE_AI_REFERENCE_JPEG_QUALITY=84
# Photo analysis only names garments and places boxes on a 1000x1000 grid, so it
# runs below the generation reference size. Provider input cost scales with
# resolution; raise this if crowded photos start losing small accessories.
WARDROBE_AI_ANALYSIS_MAX_EDGE=1024
OPENROUTER_API_KEY=
# OpenRouter uses these attribution headers in its Apps analytics. On Railway,
# OPENROUTER_APP_URL defaults automatically to https://$RAILWAY_PUBLIC_DOMAIN.
# Set it explicitly when using a custom domain or a different canonical URL.
# OPENROUTER_APP_URL=https://wardrobe.example.com
OPENROUTER_APP_TITLE=Wardrobe
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PLANNER_MODEL=google/gemini-3.1-flash-lite
# Retried only when the primary planner provider fails or returns invalid JSON.
# Gemini 2.5 Flash Lite is inexpensive and currently has healthy ZDR routes.
OPENROUTER_PLANNER_FALLBACK_MODELS=google/gemini-2.5-flash-lite
# Seedream is the recommended garment route: predictable per-image pricing and ZDR.
OPENROUTER_GARMENT_MODEL=bytedance-seed/seedream-4.5
# Nano Banana 2 is the default for modeled looks because it provides stronger
# identity and garment consistency than the economy Flash Lite image route.
OPENROUTER_MODELED_MODEL=google/gemini-3.1-flash-image
OPENROUTER_MODELED_MULTI_REFERENCE_MODEL=google/gemini-3.1-flash-image
# Lowest-cost broad video default: 4/6/8/10 seconds, 480p–1080p, optional
# synchronized audio, and modeled-look anchoring as either the first or last frame.
OPENROUTER_VIDEO_MODEL=bytedance/seedance-1-5-pro
# Enable this only if a profile deliberately chooses the cheaper Klein route,
# which currently has no ZDR endpoint on OpenRouter.
OPENROUTER_ALLOW_NON_ZDR_GARMENT=false
# Usually unnecessary: Wardrobe already routes Klein through Black Forest Labs
# when Klein is the chosen garment model. A provider override is only honored
# for models that provider actually serves, so switching the garment model from
# the profile's AI preferences cannot be broken by a stale pin left here.
# OPENROUTER_GARMENT_PROVIDER=seed
# Retried in order only when an image model returns a safety-policy refusal.
# Set this to none to disable automatic safety fallback.
OPENROUTER_IMAGE_FALLBACK_MODELS=bytedance-seed/seedream-4.5
# Seed is currently a ZDR endpoint for the default fallback model.
OPENROUTER_IMAGE_FALLBACK_PROVIDER=seed
# Keep the cheap primary image call at 1K. Seedream landscape fallbacks need 4K
# on the current Seed route; Wardrobe also steps up if a route asks for more.
OPENROUTER_IMAGE_RESOLUTION=1K
OPENROUTER_IMAGE_FALLBACK_RESOLUTION=4K
OPENROUTER_IMAGE_QUALITY=auto
OPENROUTER_ZDR=true

# Optional: pin image requests to a specific OpenRouter provider tag.
# With the Google models above and ZDR enabled, Wardrobe automatically uses
# google-vertex/global so photos are not routed through Google AI Studio, so
# these are rarely needed. A pin is applied only when the chosen model is
# actually served by that provider; otherwise Wardrobe logs a warning and routes
# automatically rather than sending a request OpenRouter has to reject.
# OPENROUTER_IMAGE_PROVIDER=google-vertex/global
# OPENROUTER_MODELED_PROVIDER=google-vertex/global

# Direct OpenAI remains supported. Uncomment this block and change the provider.
# WARDROBE_AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-5.4-mini
# OPENAI_PLANNER_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high

# Optional first-run profile name and legacy reference bootstrap.
# After startup, add/edit users and their 1-3 reference photos in the app.
# WARDROBE_DEFAULT_USER_NAME=My wardrobe
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# A comma-separated list takes precedence over the single legacy reference.
# WARDROBE_MODEL_REFERENCES=data/model-front.jpg,data/model-three-quarter.jpg,data/model-full-body.jpg
